*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# Books corpus (large; distribute separately or via DVC)
books/

# Extracted data artefacts (rebuilt by pipeline; commit only index files for deployment)
data/substitutions.jsonl
data/measurements.jsonl
data/terms.jsonl
data/substitutions_enriched.jsonl
data/substitutions_enriched.bak.jsonl
data/substitutions_enriched_gcs.jsonl
