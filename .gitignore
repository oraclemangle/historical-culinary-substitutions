data/meta.npy

# Large index/data files — download from GCS at deploy time via sync_data.py
data/*.faiss
data/*.npy
data/crossref.json

# Audit report contains 200 raw substitution records — protect CC BY-NC dataset moat
data/audit_report.json

# Keep small JSON metadata in git:
# data/crossref_stats.json
# data/book_meta.json
# data/validation_report.json

# Logs
logs/
*.log
nohup.out

# Credentials — NEVER commit
*.json
!data/*.json

# Re-exclude specific data/*.json files (override !data/*.json above)
data/crossref.json
data/audit_report.json

